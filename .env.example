# Copy to `.env` (gitignored) for local `npm run build` / `npm run deploy`.
# `src/integrations/postbuild.ts` loads it; variables already set in the shell win.

# --- Build: security.txt signing (README.md → "security.txt signing key") ---
# On Workers Builds these are *build* secrets (dashboard → Workers → dwk → Settings → Build),
# base64-encoded on one line; here the armored key can stay as-is. Unset, the local build
# skips signing; production builds on `main` fail without it.
GPG_PRIVATE_KEY=
# Only if the key is passphrase-protected.
GPG_PASSPHRASE=

# --- Deploy: wrangler auth ---
# Not needed after `npx wrangler login`; set for non-interactive deploys.
# Token needs Workers Scripts:Edit (account_id is pinned in wrangler.jsonc).
CLOUDFLARE_API_TOKEN=

# --- scripts/refollow.mjs ---
# Same value as the Worker's ACTIVITYPUB_PUBLISH_TOKEN secret.
ACTIVITYPUB_PUBLISH_TOKEN=

# --- Worker runtime secrets: NOT read from this file ---
# Set with `npx wrangler secret put <NAME>` (production) or in `.dev.vars` (`wrangler dev`).
# See CLAUDE.md → "Secrets" for what each one does and the one-time setup commands.
# A mount whose secret is unset answers 503; only TOKEN_SIGNING_KEY is required.
#
# TOKEN_SIGNING_KEY=            # random; required
# OWNER_TOKEN=                  # random; keep it, it's the owner's bearer
# INTROSPECTION_TOKEN=          # random; optional, enables /auth/introspect
# ACTIVITYPUB_PUBLIC_KEY_PEM=   # RSA 2048 PEM
# ACTIVITYPUB_PRIVATE_KEY_PEM=  # RSA 2048 PEM
# ACTIVITYPUB_PUBLISH_TOKEN=    # random; keep it
# ATPROTO_PASSWORD=             # random; keep it
# ATPROTO_JWT_SECRET=           # random
# VC_SIGNING_KEY=               # P-256 private JWK
# WEBDAV_PEPPER=                # random
