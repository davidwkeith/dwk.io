---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { site } from '../data/site';
import { schema } from '../data/schema';
import { cv } from '../data/cv';

const projects = (await getCollection('projects')).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const pageSchema = {
  "@context": "https://schema.org",
  "@type": "ProfilePage",
  mainEntity: schema.author,
};
---

<BaseLayout description="The Cyber Home of DWK" schema={pageSchema}>
  <div class="h-card">
    <img class="u-photo" src="/icon-512.png" alt="" width="48" height="48">
    <a class="p-name u-url u-uid" href={site.url}>{schema.author.name}</a>,
    <span class="p-note">{cv.headline}</span>
    · <a href="/posts/">Posts</a>
    · <a href="/cv/">CV</a>
  </div>
  <div class="h-feed">
    <h2><span class="p-name">Projects</span> by <a class="p-author h-card" href={site.url}>{schema.author.name}</a></h2>
    <ul>
      {projects.map(project => (
        <li class="h-entry">
          <a class="u-url p-name" href={`/${project.id}/`}>{project.data.title}</a>
          · <time class="dt-published" datetime={project.data.date.toISOString()}>{project.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</time>
          {project.data.description && <p class="p-summary">{project.data.description}</p>}
        </li>
      ))}
    </ul>
  </div>
</BaseLayout>
