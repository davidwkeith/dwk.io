{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "dwk",
  "main": "worker.ts",
  "compatibility_date": "2026-02-18",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },
  // Mirrors the dashboard's Observability settings so deploys don't revert
  // them. Traffic is low enough to keep every request (sampling rate 1 = 100%).
  // The dashboard snippet calls the last block "issue_detection"; wrangler's
  // schema names it "issues".
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true
    },
    "issues": {
      "enabled": true
    }
  },
  // IndieAuth (worker.ts). Also needs the TOKEN_SIGNING_KEY secret, and an
  // Access app guarding dwk.io/auth/login whose AUD tag goes in ACCESS_AUD.
  // WEBMENTION_INBOX reuses this same D1 database (the D1 free-plan limit is
  // maxed out) — @dwk/webmention creates its own `webmentions` table there,
  // separate from IndieAuth's tables.
  "d1_databases": [
    {
      "binding": "AUTH_DB",
      "database_name": "dwk-indieauth",
      "database_id": "1c0d0b8a-87e3-4858-89f9-0fea65dedf3f"
    },
    {
      "binding": "WEBMENTION_INBOX",
      "database_name": "dwk-indieauth",
      "database_id": "1c0d0b8a-87e3-4858-89f9-0fea65dedf3f"
    }
  ],
  // Webmention async verification (worker.ts).
  "queues": {
    "producers": [{ "queue": "dwk-webmention-verify", "binding": "WEBMENTION_QUEUE" }],
    "consumers": [{ "queue": "dwk-webmention-verify" }]
  },
  // Caps abuse of the public POST /webmention endpoint, which triggers an
  // outbound fetch per accepted request. namespace_id is an arbitrary
  // account-unique id, not a created resource.
  "ratelimits": [
    {
      "name": "WEBMENTION_RATE_LIMITER",
      "namespace_id": "1",
      "simple": { "limit": 30, "period": 60 }
    }
  ],
  "vars": {
    "ACCESS_TEAM_DOMAIN": "dwk-io.cloudflareaccess.com",
    "ACCESS_AUD": "62980e775a5f75c44ba9b496086f9aaf18a5d6d50b2622c5ca402ce77b721a24"
  },
  // Required by `wrangler preview`, which Workers Builds runs for non-production branches.
  "previews": {}
}
