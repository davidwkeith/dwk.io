{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "dwk",
  // Pins wrangler to this account when a login can reach several, which
  // otherwise fails with "Please set the appropriate `account_id`".
  "account_id": "a512f9f4b2868e12e6ad44a191fd5b96",
  "main": "worker.ts",
  "compatibility_date": "2026-02-18",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },
  // Mirrors the dashboard's Observability settings so deploys don't revert
  // them. Traffic is low enough to keep every request (sampling rate 1 = 100%).
  // The dashboard snippet calls the last block "issue_detection"; wrangler's
  // schema names it "issues".
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true
    },
    "issues": {
      "enabled": true
    }
  },
  // Every @dwk/workers endpoint package is composed into this Worker
  // (worker.ts + worker/). Each binding below is one a package's Env fragment
  // declares; the secrets are listed in CLAUDE.md.
  "compatibility_flags": ["nodejs_compat"],
  // The Durable Objects the packages ship, re-exported from worker.ts.
  // ActivityPubObject was registered on the live Worker first (tag "v1", from
  // a test deploy); the other four follow in "v2". If a deploy warns that the
  // Worker's migration tag was not found here, rename "v1" to the tag named.
  "durable_objects": {
    "bindings": [
      { "name": "ACTOR", "class_name": "ActivityPubObject" },
      { "name": "POD", "class_name": "SolidPodObject" },
      { "name": "STORAGE", "class_name": "RemoteStorageObject" },
      { "name": "WEBAUTHN", "class_name": "WebAuthnObject" },
      { "name": "REPO", "class_name": "AtprotoRepoObject" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["ActivityPubObject"] },
    {
      "tag": "v2",
      "new_sqlite_classes": ["SolidPodObject", "RemoteStorageObject", "WebAuthnObject", "AtprotoRepoObject"]
    }
  ],
  // Blob bodies for the pods / atproto (BLOBS) and Micropub media (MEDIA).
  "r2_buckets": [
    { "binding": "BLOBS", "bucket_name": "dwk-blobs" },
    { "binding": "MEDIA", "bucket_name": "dwk-media" }
  ],
  // The D1 free-plan database limit is maxed out, so every D1 binding points
  // at the one `dwk-indieauth` database: each package creates its own tables
  // there (names checked disjoint across the cohort), so sharing is safe.
  "d1_databases": [
    { "binding": "AUTH_DB", "database_name": "dwk-indieauth", "database_id": "1c0d0b8a-87e3-4858-89f9-0fea65dedf3f" },
    { "binding": "WEBMENTION_INBOX", "database_name": "dwk-indieauth", "database_id": "1c0d0b8a-87e3-4858-89f9-0fea65dedf3f" },
    { "binding": "MICROPUB_DB", "database_name": "dwk-indieauth", "database_id": "1c0d0b8a-87e3-4858-89f9-0fea65dedf3f" },
    { "binding": "MICROSUB_DB", "database_name": "dwk-indieauth", "database_id": "1c0d0b8a-87e3-4858-89f9-0fea65dedf3f" },
    { "binding": "WEBSUB_DB", "database_name": "dwk-indieauth", "database_id": "1c0d0b8a-87e3-4858-89f9-0fea65dedf3f" },
    { "binding": "VC_STATUS_DB", "database_name": "dwk-indieauth", "database_id": "1c0d0b8a-87e3-4858-89f9-0fea65dedf3f" },
    { "binding": "GC_DB", "database_name": "dwk-indieauth", "database_id": "1c0d0b8a-87e3-4858-89f9-0fea65dedf3f" }
  ],
  // Async work: Webmention verification, WebSub fan-out, Microsub polling.
  "queues": {
    "producers": [
      { "queue": "dwk-webmention-verify", "binding": "WEBMENTION_QUEUE" },
      { "queue": "dwk-websub", "binding": "WEBSUB_QUEUE" },
      { "queue": "dwk-microsub", "binding": "MICROSUB_QUEUE" }
    ],
    "consumers": [{ "queue": "dwk-webmention-verify" }, { "queue": "dwk-websub" }, { "queue": "dwk-microsub" }]
  },
  // R2 orphan-blob GC for the pods, the Microsub feed poller, and WebSub publish
  // pings for changed feeds (worker.ts `scheduled`).
  "triggers": { "crons": ["*/15 * * * *"] },
  // Caps abuse of the public POST /webmention endpoint, which triggers an
  // outbound fetch per accepted request. namespace_id is an arbitrary
  // account-unique id, not a created resource.
  "ratelimits": [
    {
      "name": "WEBMENTION_RATE_LIMITER",
      "namespace_id": "1",
      "simple": { "limit": 30, "period": 60 }
    }
  ],
  "vars": {
    "ACCESS_TEAM_DOMAIN": "dwk-io.cloudflareaccess.com",
    "ACCESS_AUD": "62980e775a5f75c44ba9b496086f9aaf18a5d6d50b2622c5ca402ce77b721a24"
  },
  // Worker Previews (`wrangler preview`, which Workers Builds runs for
  // non-production branches) inherit nothing from the top level, so every
  // binding the code reads from `env` is repeated here or the Preview answers
  // 500/1101 on those paths. Each Preview gets its own Durable Object
  // namespace automatically; the D1 database (free-plan limit), the R2
  // buckets, and the queues are shared with production, whose Worker runs the
  // queue consumers and the cron. Preview secrets are set once with
  // `npx wrangler preview base-config secret put <NAME>` (see CLAUDE.md).
  "previews": {
    "vars": {
      "ACCESS_TEAM_DOMAIN": "dwk-io.cloudflareaccess.com",
      "ACCESS_AUD": "62980e775a5f75c44ba9b496086f9aaf18a5d6d50b2622c5ca402ce77b721a24"
    },
    "durable_objects": {
      "bindings": [
        { "name": "ACTOR", "class_name": "ActivityPubObject" },
        { "name": "POD", "class_name": "SolidPodObject" },
        { "name": "STORAGE", "class_name": "RemoteStorageObject" },
        { "name": "WEBAUTHN", "class_name": "WebAuthnObject" },
        { "name": "REPO", "class_name": "AtprotoRepoObject" }
      ]
    },
    "r2_buckets": [
      { "binding": "BLOBS", "bucket_name": "dwk-blobs" },
      { "binding": "MEDIA", "bucket_name": "dwk-media" }
    ],
    "d1_databases": [
      { "binding": "AUTH_DB", "database_name": "dwk-indieauth", "database_id": "1c0d0b8a-87e3-4858-89f9-0fea65dedf3f" },
      { "binding": "WEBMENTION_INBOX", "database_name": "dwk-indieauth", "database_id": "1c0d0b8a-87e3-4858-89f9-0fea65dedf3f" },
      { "binding": "MICROPUB_DB", "database_name": "dwk-indieauth", "database_id": "1c0d0b8a-87e3-4858-89f9-0fea65dedf3f" },
      { "binding": "MICROSUB_DB", "database_name": "dwk-indieauth", "database_id": "1c0d0b8a-87e3-4858-89f9-0fea65dedf3f" },
      { "binding": "WEBSUB_DB", "database_name": "dwk-indieauth", "database_id": "1c0d0b8a-87e3-4858-89f9-0fea65dedf3f" },
      { "binding": "VC_STATUS_DB", "database_name": "dwk-indieauth", "database_id": "1c0d0b8a-87e3-4858-89f9-0fea65dedf3f" },
      { "binding": "GC_DB", "database_name": "dwk-indieauth", "database_id": "1c0d0b8a-87e3-4858-89f9-0fea65dedf3f" }
    ],
    "queues": {
      "producers": [
        { "queue": "dwk-webmention-verify", "binding": "WEBMENTION_QUEUE" },
        { "queue": "dwk-websub", "binding": "WEBSUB_QUEUE" },
        { "queue": "dwk-microsub", "binding": "MICROSUB_QUEUE" }
      ]
    },
    "ratelimits": [
      {
        "name": "WEBMENTION_RATE_LIMITER",
        "namespace_id": "1",
        "simple": { "limit": 30, "period": 60 }
      }
    ]
  }
}
